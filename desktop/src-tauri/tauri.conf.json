{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swarmdash",
  "identifier": "tu.snaketech.swarmdash",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Read-only dashboard for Docker Swarm and Compose stacks",
    "longDescription": "swarmdash shows nodes, stacks, services and logs of Docker Swarm and Docker Compose hosts, locally or over SSH. It only reads and never changes anything on the server.",
    "copyright": "SnakeTech",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/snaketech-tu/swarmdash/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
